{% assign basics = data[1] %}

<div class="cv-basics">
  <h4 class="font-weight-bold mb-1">{{ basics.name }}</h4>
  {% if basics.label %}
    <p class="mb-2">{{ basics.label }}</p>
  {% endif %}

  <p class="mb-3">
    {% if basics.email %}
      <a href="mailto:{{ basics.email }}">{{ basics.email }}</a>
    {% endif %}
    {% if basics.url %}
      {% if basics.email %} | {% endif %}
      <a href="{{ basics.url }}" target="_blank" rel="noopener noreferrer">{{ basics.url | remove: 'https://' | remove: 'http://' }}</a>
    {% endif %}
    {% for profile in basics.profiles %}
      {% if profile.network == 'Google Scholar' %}
        | scholar:{{ profile.username }}
      {% elsif profile.network == 'GitHub' %}
        | <a href="{{ profile.url }}" target="_blank" rel="noopener noreferrer">github.com/{{ profile.username }}</a>
      {% endif %}
    {% endfor %}
  </p>

  {% if basics.summary %}
    <p class="mb-0">{{ basics.summary }}</p>
  {% endif %}
</div>
